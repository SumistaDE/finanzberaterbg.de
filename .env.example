# Mollie payment integration (server-side only)
MOLLIE_API_KEY=live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL of the deployed site. Used to build the Mollie redirect URL
# and the webhook URL. Must be a public URL for webhooks to work.
BASE_URL=https://finanzberaterbg.de

# Currency for all prices (ISO 4217).
CURRENCY=EUR

# --- Email delivery of the PDF manual (Resend) ---
# Without these the payment still works; the email is simply skipped.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Finanzberater BG <info@finanzberaterbg.de>
